{
  "name": "notesense",
  "version": "0.16.0",
  "private": true,
  "license": "UNLICENSED",
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": ">=22 <23",
    "npm": ">=10 <11"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "format:check": "prettier --check .",
    "format:write": "prettier --write .",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc -b && tsc -p tsconfig.node.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:pages": "playwright test --config=playwright.pages.config.ts",
    "test:e2e:resilience": "playwright test --config=playwright.resilience.config.ts",
    "test:e2e:visual": "playwright test --config=playwright.visual.config.ts",
    "test:e2e:visual:update": "playwright test --config=playwright.visual.config.ts --update-snapshots",
    "test:watch": "vitest",
    "repo:hygiene": "node scripts/check-repository-hygiene.mjs",
    "docs:policy": "node scripts/check-policy-docs.mjs",
    "docs:integrity": "node scripts/check-doc-integrity.mjs",
    "docs:check": "npm run docs:policy && npm run docs:integrity",
    "docs:screenshots": "npm run build && node scripts/capture-screenshots.mjs",
    "adr:check": "node scripts/check-adr-contracts.mjs",
    "product:check": "node scripts/check-product-scope.mjs",
    "product:learning": "node scripts/check-product-learning-contract.mjs",
    "review:check": "node scripts/check-review-process.mjs",
    "dependencies:check": "node scripts/check-dependency-maintenance.mjs",
    "legal:check": "node scripts/check-legal-contract.mjs",
    "data:check": "node scripts/check-data-contracts.mjs",
    "i18n:check": "node scripts/check-i18n-contract.mjs",
    "security:privacy": "node scripts/check-security-privacy.mjs",
    "architecture:check": "node scripts/check-architecture-boundaries.mjs",
    "design:check": "node scripts/check-design-system.mjs",
    "accessibility:check": "node scripts/check-accessibility-contracts.mjs",
    "testing:check": "node scripts/check-testing-contracts.mjs",
    "browsers:check": "node scripts/check-browser-support.mjs",
    "performance:check": "node scripts/check-performance-contract.mjs",
    "operations:check": "node scripts/check-operations-contract.mjs",
    "observability:check": "node scripts/check-observability-contract.mjs",
    "release:safety": "node scripts/check-release-safety-contract.mjs",
    "release:notes": "node scripts/check-release-notes.mjs",
    "compliance:licenses": "node scripts/check-licenses.mjs",
    "security:audit": "npm audit --audit-level=high",
    "security:lockfile": "node scripts/check-lockfile-supply-chain.mjs",
    "security:workflow-actions": "node scripts/check-workflow-actions.mjs",
    "security:workflow-permissions": "node scripts/check-workflow-permissions.mjs",
    "security:workflow-operations": "node scripts/check-workflow-operations.mjs",
    "security:workflows": "npm run security:workflow-actions && npm run security:workflow-permissions && npm run security:workflow-operations",
    "security:supply-chain": "npm run security:audit && npm run security:lockfile && npm run compliance:licenses && npm run security:workflows",
    "security:policy": "node scripts/check-security-policy.mjs",
    "metadata:check": "node scripts/check-web-metadata.mjs",
    "pwa:check": "node scripts/check-pwa-artifacts.mjs",
    "runtime:check": "node scripts/check-runtime-surface.mjs",
    "perf:budget": "node scripts/check-bundle-budget.mjs",
    "ops:repository": "node scripts/check-github-repository.mjs",
    "ops:check": "npm run ops:repository",
    "deploy:verify-live": "node scripts/verify-live-pages.mjs",
    "check": "npm run format:check && npm run repo:hygiene && npm run docs:check && npm run adr:check && npm run product:check && npm run product:learning && npm run review:check && npm run dependencies:check && npm run legal:check && npm run data:check && npm run i18n:check && npm run security:privacy && npm run architecture:check && npm run design:check && npm run accessibility:check && npm run testing:check && npm run browsers:check && npm run performance:check && npm run operations:check && npm run observability:check && npm run release:safety && npm run release:notes && npm run lint && npm run typecheck && npm run test && npm run test:coverage && npm run test:e2e",
    "verify": "npm run security:supply-chain && npm run check && npm run test:e2e:resilience && npm run build:pages && npm run security:policy && npm run metadata:check && npm run pwa:check && npm run runtime:check && npm run perf:budget && npm run test:e2e:pages",
    "build": "tsc -b && vite build",
    "build:pages": "npm run typecheck && vite build --base=/notesense/",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.60.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.9.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "@vitest/coverage-v8": "^4.1.8",
    "eslint": "^9.39.4",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.8.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.61.0",
    "vite": "^8.0.16",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.8"
  }
}
