{
  "name": "notesense",
  "version": "0.16.0",
  "private": true,
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": ">=22 <23",
    "npm": ">=10 <11"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "format:check": "prettier --check .",
    "format:write": "prettier --write .",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc -b && tsc -p tsconfig.node.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:pages": "playwright test --config=playwright.pages.config.ts",
    "test:e2e:resilience": "playwright test --config=playwright.resilience.config.ts",
    "test:e2e:visual": "playwright test --config=playwright.visual.config.ts",
    "test:e2e:visual:update": "playwright test --config=playwright.visual.config.ts --update-snapshots",
    "test:watch": "vitest",
    "docs:policy": "node scripts/check-policy-docs.mjs",
    "docs:integrity": "node scripts/check-doc-integrity.mjs",
    "docs:check": "npm run docs:policy && npm run docs:integrity",
    "docs:screenshots": "npm run build && node scripts/capture-screenshots.mjs",
    "compliance:licenses": "node scripts/check-licenses.mjs",
    "security:audit": "npm audit --audit-level=high",
    "security:workflow-actions": "node scripts/check-workflow-actions.mjs",
    "security:workflow-permissions": "node scripts/check-workflow-permissions.mjs",
    "security:workflows": "npm run security:workflow-actions && npm run security:workflow-permissions",
    "security:policy": "node scripts/check-security-policy.mjs",
    "metadata:check": "node scripts/check-web-metadata.mjs",
    "pwa:check": "node scripts/check-pwa-artifacts.mjs",
    "runtime:check": "node scripts/check-runtime-surface.mjs",
    "perf:budget": "node scripts/check-bundle-budget.mjs",
    "ops:repository": "node scripts/check-github-repository.mjs",
    "ops:check": "npm run ops:repository",
    "deploy:verify-live": "node scripts/verify-live-pages.mjs",
    "check": "npm run format:check && npm run docs:check && npm run lint && npm run typecheck && npm run test && npm run test:coverage && npm run test:e2e",
    "verify": "npm run security:audit && npm run compliance:licenses && npm run security:workflows && npm run check && npm run test:e2e:resilience && npm run build:pages && npm run security:policy && npm run metadata:check && npm run pwa:check && npm run runtime:check && npm run perf:budget && npm run test:e2e:pages",
    "build": "tsc -b && vite build",
    "build:pages": "npm run typecheck && vite build --base=/notesense/",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.60.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.9.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "@vitest/coverage-v8": "^4.1.8",
    "eslint": "^9.39.4",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.8.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.61.0",
    "vite": "^7.1.12",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.8"
  }
}
